@inproceedings{bryant2025certifying,
  author    = {Bryant, Randal E. and Tan, Yong Kiam and Heule, Marijn J. H.},
  title     = {Certifying Projected Knowledge Compilation},
  booktitle = {28th International Conference on Theory and Applications of
               Satisfiability Testing (SAT 2025)},
  series    = {LIPIcs},
  volume    = {341},
  pages     = {8:1--8:22},
  publisher = {Schloss Dagstuhl -- Leibniz-Zentrum f{\"u}r Informatik},
  year      = {2025},
  doi       = {10.4230/LIPIcs.SAT.2025.8},
  note      = {DOI: \url{https://doi.org/10.4230/LIPIcs.SAT.2025.8}. Primary source read directly. Variables are partitioned into
               \emph{data} variables and existentially quantified variables;
               the certifier establishes that the compiler output is logically
               equivalent to the quantified input formula, with soundness
               validated in HOL4 and checkers in C and CakeML. Skolem
               assignments represent how the quantified variables may be
               assigned given an assignment to the data variables. A full-text
               search of the paper for ``Hamming'', ``distance'', ``covering
               radius'', ``diameter'' and ``metric'' returns no occurrence.}
}

