% ------------------------------------------------------------------- covering radius
@article{cohen1985covering,
  author  = {Cohen, G{\'e}rard D. and Karpovsky, Mark G. and Mattson, Jr., H. F.
             and Schatz, James R.},
  title   = {Covering Radius---Survey and Recent Results},
  journal = {IEEE Transactions on Information Theory},
  volume  = {31},
  number  = {3},
  pages   = {328--343},
  month   = may,
  year    = {1985},
  doi     = {10.1109/TIT.1985.1057043},
  note    = {DOI: \url{https://doi.org/10.1109/TIT.1985.1057043}. Primary source read directly. Corollary~1 (p.~330, following
             Lemma~1) states: ``Appending an overall parity check or the zero
             parity check increases the covering radius by one (cf.~[2]).
             Puncturing a code on $p$ coordinates reduces the covering radius
             by at most $p$.'' The covering radius there is
             $t(C)=\max\{\mathrm{wt}(y+C) : y \in \mathbb{Z}_2^n\}$, a maximum
             over the whole Hamming space. The PDF's text layer is OCR, so the
             quoted sentence was checked against its surrounding paragraph.}
}

